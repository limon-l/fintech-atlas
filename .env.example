# Sandbox database location (SQLite). Swap to PostgreSQL via a repository adapter for production.
DATABASE_PATH=./data/atlas.db

# Sessions use random opaque tokens; only SHA-256 token hashes are stored.

# Public base URL used in receipts and developer examples.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The platform is a simulation. Never enable live money movement without licensed providers.
ATLAS_MODE=sandbox
